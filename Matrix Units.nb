(* Content-type: application/vnd.wolfram.mathematica *)

(*** Wolfram Notebook File ***)
(* http://www.wolfram.com/nb *)

Notebook[{
Cell["Matrix units in the Gelfand-Tsetlin basis", "Title"],

Cell["The algebra of partially transposed permutations on the tensor space", "Subtitle"],

Cell[TextData[{"For two paths T and S to the same irrep, the matrix unit E_(T,S) maps the Gelfand-Tsetlin basis vector S to T. On the tensor space (\[DoubleStruckCapitalC]^d)^\[CircleTimes]n \[CircleTimes] (\[DoubleStruckCapitalC]^d*)^\[CircleTimes]m it is the sum of |T, P\[RightAngleBracket]\[LeftAngleBracket]S, P| over all Gelfand-Tsetlin patterns P of the corresponding irrep of U(d). ", StyleBox["MatrixUnit", FontFamily->"Courier"], " builds it from products of Clebsch-Gordan tensors along the two paths."}], "Text"],

Cell["Setup", "Section"],

Cell[BoxData[RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"Mixed Schur Tools.wl\""}], "}"}], "]"}], "]"}]], "Input", InitializationCell->True],

Cell["Three left and one right tensor factor of dimension two, and the irrep with left partition {2} and empty right partition:", "Text"],

Cell[BoxData[{RowBox[{"{", RowBox[{"n", ",", "m", ",", "d"}], "}", "=", "{", RowBox[{"3", ",", "1", ",", "2"}], "}", ";"}], "\[IndentingNewLine]", RowBox[{"\[Lambda]", "=", "{", RowBox[{"2", ",", "0"}], "}", ";"}], "\[IndentingNewLine]", RowBox[{"paths", "=", "PathsToIrrepWBA", "[", RowBox[{"\[Lambda]", ",", "n", ",", "m", ",", "d"}], "]"}]}], "Input"],

Cell["The paths as pairs of mixed Young tableaux:", "Text"],

Cell[BoxData[RowBox[{"DisplayPath", "/@", "paths"}]], "Input"],

Cell["A matrix unit", "Section"],

Cell[BoxData[{RowBox[{"e", "=", "MatrixUnit", "[", RowBox[{RowBox[{"paths", "[", RowBox[{"[", "1", "]"}], "]"}], ",", RowBox[{"paths", "[", RowBox[{"[", "2", "]"}], "]"}]}], "]", ";"}], "\[IndentingNewLine]", RowBox[{"e", "//", "MatrixForm"}]}], "Input"],

Cell["In the mixed Schur basis, E_(T,S) is the matrix unit |T\[RightAngleBracket]\[LeftAngleBracket]S| of the walled Brauer irrep tensored with the identity on the irrep of U(d):", "Text"],

Cell[BoxData[{RowBox[{"schur", "=", "SchurTransform", "[", RowBox[{"n", ",", "m", ",", "d"}], "]", ";"}], "\[IndentingNewLine]", RowBox[{"schur", ".", "e", ".", "Transpose", "[", "schur", "]", "//", "MatrixForm"}]}], "Input"],

Cell["Relations", "Section"],

Cell[TextData[{"Matrix units multiply as E_(T,S) E_(S',R) = \[Delta]_(S,S') E_(T,R). Since the entries are exact algebraic numbers, ", StyleBox["zeroQ", FontFamily->"Courier"], " tests a matrix for zero with ", StyleBox["PossibleZeroQ", FontFamily->"Courier"], ":"}], "Text"],

Cell[BoxData[{RowBox[{"zeroQ", "[", "a_", "]", ":=", "AllTrue", "[", RowBox[{RowBox[{"Flatten", "@", "Normal", "@", "a"}], ",", "PossibleZeroQ"}], "]"}], "\[IndentingNewLine]", RowBox[{"units", "=", "Table", "[", RowBox[{RowBox[{"MatrixUnit", "[", RowBox[{"T", ",", "R"}], "]"}], ",", RowBox[{"{", RowBox[{"T", ",", "paths"}], "}"}], ",", RowBox[{"{", RowBox[{"R", ",", "paths"}], "}"}]}], "]", ";"}], "\[IndentingNewLine]", RowBox[{"AllTrue", "[", RowBox[{RowBox[{"Flatten", "@", "Table", "[", RowBox[{RowBox[{"\[IndentingNewLine]", "zeroQ", "[", RowBox[{"units", "[", RowBox[{"[", RowBox[{"i", ",", "j"}], "]"}], "]", ".", "units", "[", RowBox[{"[", RowBox[{"k", ",", "l"}], "]"}], "]", "-", "If", "[", RowBox[{RowBox[{"j", "==", "k"}], ",", RowBox[{"units", "[", RowBox[{"[", RowBox[{"i", ",", "l"}], "]"}], "]"}], ",", "0"}], "]"}], "]"}], ",", RowBox[{"\[IndentingNewLine]", "{", RowBox[{"i", ",", RowBox[{"Length", "@", "paths"}]}], "}"}], ",", RowBox[{"{", RowBox[{"j", ",", RowBox[{"Length", "@", "paths"}]}], "}"}], ",", RowBox[{"{", RowBox[{"k", ",", RowBox[{"Length", "@", "paths"}]}], "}"}], ",", RowBox[{"{", RowBox[{"l", ",", RowBox[{"Length", "@", "paths"}]}], "}"}]}], "]"}], ",", "TrueQ"}], "]"}]}], "Input"],

Cell["The diagonal matrix units E_(T,T) of all irreps add up to the identity on the tensor space:", "Text"],

Cell[BoxData[RowBox[{"Total", "[", RowBox[{"MatrixUnit", "[", RowBox[{"#", ",", "#"}], "]", "&", "/@", "Catenate", "@", "AllPathsWBA", "[", RowBox[{"n", ",", "m", ",", "d"}], "]"}], "]", "==", "IdentityMatrix", "[", RowBox[{"d", "^", "(", RowBox[{"n", "+", "m"}], ")"}], "]"}]], "Input"]
},
StyleDefinitions->"Default.nb"
]
