(* Content-type: application/vnd.wolfram.mathematica *)

(*** Wolfram Notebook File ***)

Notebook[{
Cell["Port-based teleportation in the Gelfand-Tsetlin basis", "Title"],

Cell["Pretty good measurement and its Naimark dilation", "Subtitle"],

Cell[TextData[{"This notebook accompanies arXiv:2310.02252. In port-based teleportation the sender and the receiver share n maximally entangled pairs of dimension d, and the receiver's halves are the ports. The sender measures the other n halves together with the system to be teleported, which enters through the dual representation. The relevant algebra is therefore the algebra of partially transposed permutations with n left and m = 1 right tensor factors. All computations below use the functions of ", StyleBox["Mixed Schur Tools.wl", FontFamily -> "Courier"], "."}], "Text"],

Cell["Setup", "Section"],

Cell["Choose Evaluation > Evaluate Notebook to run all examples from the top. The setup loads the package and the default parameters. Display helpers are grouped below; open that group only if you want to customize the presentation.", "Text"],

Cell[BoxData[RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"ParentDirectory", "[", RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ",", " ", "\"Mixed Schur Tools.wl\""}], "}"}], "\n", "  ", "]"}], "]"}]], "Input", InitializationCell -> True],

Cell["Four ports of dimension three and one dual system:", "Text"],

Cell[BoxData[RowBox[{RowBox[{RowBox[{"{", RowBox[{"n", ",", " ", "m", ",", " ", "d"}], "}"}], " ", "=", " ", RowBox[{"{", RowBox[{"4", ",", " ", "1", ",", " ", "3"}], "}"}]}], ";"}]], "Input", InitializationCell -> True],

Cell[CellGroupData[{Cell["Display helpers", "Subsection"], Cell[BoxData[RowBox[{RowBox[{"pathView", "[", "paths_", "]"}], " ", ":=", "\n", "  ", RowBox[{"Grid", "[", RowBox[{RowBox[{"Partition", "[", RowBox[{RowBox[{"MapIndexed", "[", RowBox[{RowBox[{RowBox[{"Column", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"Style", "[", RowBox[{RowBox[{"Row", "[", RowBox[{"{", RowBox[{"\"path \"", ",", " ", RowBox[{"First", "[", "#2", "]"}]}], "}"}], "]"}], ",", " ", "Small"}], "]"}], ",", " ", RowBox[{"DisplayPath", "[", "\n", "    ", "#1", "]"}]}], "}"}], ",", " ", RowBox[{"Alignment", " ", "->", " ", "Center"}], ",", " ", RowBox[{"Spacings", " ", "->", " ", "0.6"}]}], "]"}], "&"}], ",", " ", "paths"}], "]"}], ",", " ", RowBox[{"UpTo", "[", "3", "]"}]}], "]"}], ",", " ", RowBox[{"Alignment", " ", "->", " ", "Center"}], ",", "\n", "     ", RowBox[{"Spacings", " ", "->", " ", RowBox[{"{", RowBox[{"2", ",", " ", "1.2"}], "}"}]}]}], "]"}]}]], "Input", InitializationCell -> True], Cell[BoxData[RowBox[{RowBox[{"pathsByIrrepView", "[", RowBox[{"groups_", ",", " ", "labels_"}], "]"}], " ", ":=", "\n", "  ", RowBox[{"Column", "[", RowBox[{RowBox[{"MapThread", "[", RowBox[{RowBox[{RowBox[{"Column", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"Row", "[", RowBox[{"{", RowBox[{"\"Irrep \"", ",", " ", RowBox[{"DisplayStaircase", "[", "#2", "]"}]}], "}"}], "]"}], ",", " ", RowBox[{"pathView", "[", "#1", "]"}]}], "}"}], ",", "\n", "     ", RowBox[{"Spacings", " ", "->", " ", "0.8"}]}], "]"}], "&"}], ",", " ", RowBox[{"{", RowBox[{"groups", ",", " ", "labels"}], "}"}]}], "]"}], ",", " ", RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]}]], "Input", InitializationCell -> True], Cell[BoxData[RowBox[{RowBox[{"commutationView", "[", RowBox[{"measurement_", ",", " ", "labels_"}], "]"}], " ", ":=", "\n", "  ", RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{"pairs", " ", "=", " ", RowBox[{"Flatten", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"{", RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", RowBox[{"{", RowBox[{"i", ",", " ", RowBox[{"Length", "[", RowBox[{"First", "[", "measurement", "]"}], "]"}]}], "}"}], ",", " ", RowBox[{"{", RowBox[{"j", ",", " ", "i", ",", " ", RowBox[{"Length", "[", "\n", "    ", RowBox[{"First", "[", "measurement", "]"}], "]"}]}], "}"}]}], "]"}], ",", " ", "1"}], "]"}]}], "}"}], ",", "\n", "    ", RowBox[{"Column", "[", "\n", "      ", RowBox[{RowBox[{"{", "\n", "        ", RowBox[{RowBox[{"Style", "[", RowBox[{"\"yes: commute    no: do not commute\"", ",", " ", "Small"}], "]"}], "\n", "        ", ",", "\n", "        ", RowBox[{"Grid", "[", "\n", "          ", RowBox[{RowBox[{"Prepend", "[", "\n", "            ", RowBox[{RowBox[{"MapThread", "[", "\n", "              ", RowBox[{"Prepend", "\n", "              ", ",", "\n", "              ", RowBox[{"{", "\n", "                ", RowBox[{RowBox[{"Table", "[", "\n", "                  ", RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"commuteQ", "[", RowBox[{RowBox[{"measurement", "[", RowBox[{"[", RowBox[{"l", ",", " ", RowBox[{"pair", "[", RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}], ",", " ", RowBox[{"measurement", "[", RowBox[{"[", RowBox[{"l", ",", " ", RowBox[{"pair", "\n", "                    ", "[", RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}]}], "]"}], ",", "\n", "                    ", "\"yes\"", "\n", "                    ", ",", "\n", "                    ", "\"no\""}], "\n", "                  ", "]"}], "\n", "                  ", ",", "\n", "                  ", RowBox[{"{", RowBox[{"l", ",", " ", RowBox[{"Length", "[", "labels", "]"}]}], "}"}], "\n", "                  ", ",", "\n", "                  ", RowBox[{"{", RowBox[{"pair", ",", " ", "pairs"}], "}"}]}], "\n", "                ", "]"}], "\n", "                ", ",", "\n", "                ", RowBox[{"DisplayStaircase", " ", "/@", " ", "labels"}]}], "\n", "              ", "}"}]}], "\n", "            ", "]"}], "\n", "            ", ",", "\n", "            ", RowBox[{"Prepend", "[", RowBox[{RowBox[{RowBox[{"(", RowBox[{RowBox[{"Row", "[", RowBox[{"{", RowBox[{RowBox[{"#1", "[", RowBox[{"[", "1", "]"}], "]"}], ",", " ", "\",\"", ",", " ", RowBox[{"#1", "[", RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}], "&"}], ")"}], " ", "/@", " ", "pairs"}], ",", " ", "\"irrep / ports\""}], "]"}]}], "\n", "          ", "]"}], "\n", "          ", ",", "\n", "          ", RowBox[{"Frame", " ", "->", " ", "All"}], "\n", "          ", ",", "\n", "          ", RowBox[{"Alignment", " ", "->", " ", "Center"}], "\n", "          ", ",", "\n", "          ", RowBox[{"Spacings", " ", "->", " ", RowBox[{"{", RowBox[{"0.8", ",", " ", "0.6"}], "}"}]}]}], "\n", "        ", "]"}]}], "\n", "      ", "}"}], "\n", "      ", ",", "\n", "      ", RowBox[{"Spacings", " ", "->", " ", "0.7"}]}], "\n", "    ", "]"}]}], "\n", "  ", "]"}]}]], "Input", InitializationCell -> True], Cell[BoxData[RowBox[{RowBox[{"eigenvalueView", "[", "a_", "]"}], " ", ":=", "\n", "  ", RowBox[{"Row", "[", "\n", "    ", RowBox[{RowBox[{RowBox[{"(", "\n", "        ", RowBox[{RowBox[{"Row", "[", "\n", "          ", RowBox[{"{", "\n", "            ", RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"IntegerQ", "[", RowBox[{"First", "[", "#1", "]"}], "]"}], ",", "\n", "              ", RowBox[{"First", "[", "#1", "]"}], "\n", "              ", ",", "\n", "              ", RowBox[{"NumberForm", "[", RowBox[{RowBox[{"N", "[", RowBox[{"First", "[", "#1", "]"}], "]"}], ",", " ", RowBox[{"{", RowBox[{"5", ",", " ", "3"}], "}"}]}], "]"}]}], "\n", "            ", "]"}], "\n", "            ", ",", "\n", "            ", "\" (\"", "\n", "            ", ",", "\n", "            ", RowBox[{"Last", "[", "#1", "]"}], "\n", "            ", ",", "\n", "            ", "\")\""}], "\n", "          ", "}"}], "\n", "        ", "]"}], "&"}], "\n", "      ", ")"}], " ", "/@", " ", RowBox[{"Reverse", "[", RowBox[{"SortBy", "[", RowBox[{RowBox[{"Normal", "[", RowBox[{"Counts", "[", RowBox[{"Round", "[", RowBox[{RowBox[{"Chop", "[", RowBox[{"Eigenvalues", "[", RowBox[{"N", "[", "a", "]"}], "]"}], "]"}], ",", " ", RowBox[{"10", " ", "^", " ", RowBox[{"(", RowBox[{"-", "10"}], "\n", "        ", ")"}]}]}], "]"}], "]"}], "]"}], ",", " ", "First"}], "]"}], "]"}]}], "\n", "    ", ",", "\n", "    ", "\", \""}], "\n", "  ", "]"}]}]], "Input", InitializationCell -> True], Cell[BoxData[RowBox[{RowBox[{"spectrumView", "[", RowBox[{"measurement_", ",", " ", "labels_"}], "]"}], " ", ":=", "\n", "  ", RowBox[{"Column", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"Style", "[", RowBox[{"\"eigenvalue (multiplicity)\"", ",", " ", "Small"}], "]"}], ",", " ", RowBox[{"Grid", "[", RowBox[{RowBox[{"Prepend", "[", RowBox[{RowBox[{"MapThread", "[", RowBox[{"Prepend", ",", "\n", "     ", RowBox[{"{", RowBox[{RowBox[{"Map", "[", RowBox[{"eigenvalueView", ",", " ", "measurement", ",", " ", RowBox[{"{", "2", "}"}]}], "]"}], ",", " ", RowBox[{"DisplayStaircase", " ", "/@", " ", "labels"}]}], "}"}]}], "]"}], ",", " ", RowBox[{"Prepend", "[", "\n", "    ", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"Row", "[", RowBox[{"{", RowBox[{"\"port \"", ",", " ", "k"}], "}"}], "]"}], ",", " ", RowBox[{"{", RowBox[{"k", ",", " ", RowBox[{"Length", "[", RowBox[{"First", "[", "measurement", "]"}], "]"}]}], "}"}]}], "]"}], ",", " ", "\"irrep\""}], "]"}]}], "]"}], ",", " ", RowBox[{"Frame", " ", "->", " ", "\n", "    ", "All"}], ",", " ", RowBox[{"Alignment", " ", "->", " ", "Center"}], ",", " ", RowBox[{"Spacings", " ", "->", " ", RowBox[{"{", RowBox[{"1", ",", " ", "0.6"}], "}"}]}]}], "]"}]}], "}"}], ",", " ", RowBox[{"Spacings", " ", "->", " ", "0.7"}]}], "]"}]}]], "Input", InitializationCell -> True]}, Closed]],

Cell[BoxData[RowBox[{RowBox[{"irreps", " ", "=", " ", RowBox[{"Irreps", "[", RowBox[{"n", ",", " ", "m", ",", " ", "d"}], "]"}]}], ";"}]], "Input"],

Cell["The irreps, drawn as staircases (right partition to the left of the wall), and the dimensions of the corresponding irreps of the walled Brauer algebra:", "Text"],

Cell[BoxData[RowBox[{"Grid", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"DisplayStaircase", " ", "/@", " ", "irreps"}], ",", " ", RowBox[{"IrrepDimsWBA", "[", RowBox[{"n", ",", " ", "m", ",", " ", "d"}], "]"}]}], "}"}], ",", " ", RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]], "Input"],

Cell["Generators in the Gelfand-Tsetlin basis", "Section"],

Cell[TextData[{StyleBox["GeneratorsGT", FontFamily -> "Courier"], " gives the matrices of the transpositions σ_1, …, σ_(n-1) and of the contraction σ_n in every irrep, indexed as [[generator, irrep]]. They satisfy the relations of the walled Brauer algebra:"}], "Text"],

Cell[BoxData[RowBox[{RowBox[{"gens", " ", "=", " ", RowBox[{"GeneratorsGT", "[", RowBox[{"n", ",", " ", "m", ",", " ", "d"}], "]"}]}], ";"}]], "Input"],

Cell[BoxData[RowBox[{"AllTrue", "[", RowBox[{RowBox[{"Flatten", "[", RowBox[{"Table", "[", RowBox[{RowBox[{"Values", "[", RowBox[{"CheckRelationsWBA", "[", RowBox[{RowBox[{"gens", "[", RowBox[{"[", RowBox[{"All", ",", " ", "l"}], "]"}], "]"}], ",", " ", "n", ",", " ", "m", ",", " ", "d"}], "]"}], "]"}], ",", " ", RowBox[{"{", RowBox[{"l", ",", " ", RowBox[{"Length", "[", "\n", "  ", "irreps", "]"}]}], "}"}]}], "]"}], "]"}], ",", " ", "TrueQ"}], "]"}]], "Input"],

Cell["Pretty good measurement", "Section"],

Cell[TextData[{"The permutation π_k = σ_k σ_(k+1) … σ_(n-1) moves port k to port n, so that ρ_k = π_k σ_n π_k^T contracts port k with the dual system. ", StyleBox["moveToPort", FontFamily -> "Courier"], " conjugates an operator on port n in this way, given the generator matrices σ of one irrep:"}], "Text"],

Cell[BoxData[RowBox[{RowBox[{"moveToPort", "[", RowBox[{"k_", ",", " ", "σ_", ",", " ", "a_"}], "]"}], " ", ":=", "\n", "  ", RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{"Pi", " ", "=", " ", RowBox[{"Fold", "[", RowBox[{"Dot", ",", " ", RowBox[{"IdentityMatrix", "[", RowBox[{"Length", "[", "a", "]"}], "]"}], ",", " ", RowBox[{"σ", "[", RowBox[{"[", RowBox[{"k", " ", ";;", " ", RowBox[{"n", " ", "-", " ", "1"}]}], "]"}], "]"}]}], "]"}]}], "}"}], ",", "\n", "    ", RowBox[{"Pi", " ", ".", " ", "a", " ", ".", " ", RowBox[{"Transpose", "[", "Pi", "]"}]}]}], "\n", "  ", "]"}]}]], "Input"],

Cell["In an irrep without right partition, the elements of the pretty good measurement are E_k = ρ^(-1/2) ρ_k ρ^(-1/2) with ρ = ρ_1 + … + ρ_n; in the other irreps they vanish.", "Text"],

Cell[BoxData[RowBox[{RowBox[{"pgm", "[", RowBox[{"σ_", ",", " ", "irrep_"}], "]"}], " ", ":=", "\n", "  ", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"ρ", " ", "=", " ", RowBox[{"Table", "[", RowBox[{RowBox[{"moveToPort", "[", RowBox[{"k", ",", " ", "σ", ",", " ", RowBox[{"σ", "[", RowBox[{"[", "n", "]"}], "]"}]}], "]"}], ",", " ", RowBox[{"{", RowBox[{"k", ",", " ", "n"}], "}"}]}], "]"}]}], ",", " ", "inverseSqrt"}], "}"}], ",", "\n", "    ", RowBox[{"If", "[", RowBox[{RowBox[{"AnyTrue", "[", RowBox[{"irrep", ",", " ", "Negative"}], "]"}], ",", "\n", "      ", RowBox[{"0", " ", "*", " ", "ρ"}], "\n", "      ", ",", "\n", "      ", RowBox[{RowBox[{"inverseSqrt", " ", "=", " ", RowBox[{"MatrixPower", "[", RowBox[{RowBox[{"Total", "[", "ρ", "]"}], ",", " ", RowBox[{"-", RowBox[{"2", " ", "^", " ", RowBox[{"(", RowBox[{"-", "1"}], ")"}]}]}]}], "]"}]}], ";", "\n", "      ", RowBox[{RowBox[{"(", RowBox[{RowBox[{"Simplify", "[", RowBox[{"inverseSqrt", " ", ".", " ", "#1", " ", ".", " ", "inverseSqrt"}], "]"}], "&"}], ")"}], " ", "/@", " ", "ρ"}]}]}], "\n", "    ", "]"}]}], "\n", "  ", "]"}]}]], "Input"],

Cell[BoxData[RowBox[{RowBox[{"povm", " ", "=", " ", RowBox[{"Table", "[", RowBox[{RowBox[{"pgm", "[", RowBox[{RowBox[{"gens", "[", RowBox[{"[", RowBox[{"All", ",", " ", "l"}], "]"}], "]"}], ",", " ", RowBox[{"irreps", "[", RowBox[{"[", "l", "]"}], "]"}]}], "]"}], ",", " ", RowBox[{"{", RowBox[{"l", ",", " ", RowBox[{"Length", "[", "irreps", "]"}]}], "}"}]}], "]"}]}], ";"}]], "Input"],

Cell["For every irrep, whether the measurement elements E_i and E_j commute, for 1 ≤ i ≤ j ≤ n. In the last irrep some of them do not:", "Text"],

Cell[BoxData[RowBox[{RowBox[{"commuteQ", "[", RowBox[{"a_", ",", " ", "b_"}], "]"}], " ", ":=", "\n", "  ", RowBox[{"AllTrue", "[", RowBox[{RowBox[{"Flatten", "[", RowBox[{"Normal", "[", RowBox[{RowBox[{"a", " ", ".", " ", "b"}], " ", "-", " ", RowBox[{"b", " ", ".", " ", "a"}]}], "]"}], "]"}], ",", " ", "PossibleZeroQ"}], "]"}]}]], "Input"],

Cell[BoxData[RowBox[{"commutationView", "[", RowBox[{"povm", ",", " ", "irreps"}], "]"}]], "Input"],

Cell["Their eigenvalues:", "Text"],

Cell[BoxData[RowBox[{"spectrumView", "[", RowBox[{"povm", ",", " ", "irreps"}], "]"}]], "Input"],

Cell["Naimark dilation", "Section"],

Cell["The Naimark dilation enlarges the Gelfand-Tsetlin basis without changing the irreps. At each left level i = 3, …, n of the Bratteli diagram, every partition with d rows on level i - 1 gets an extra vertex on level i, with one more cell in row d + 1. To hold these vertices, all staircases are padded to length d + 1.", "Text"],

Cell[BoxData[RowBox[{RowBox[{"pad", "[", RowBox[{"{", RowBox[{"s_", ",", " ", "level_"}], "}"}], "]"}], " ", ":=", "\n", "  ", RowBox[{"{", RowBox[{RowBox[{"ToStaircase", "[", RowBox[{"ReplacePart", "[", RowBox[{RowBox[{"ToPair", "[", "s", "]"}], ",", " ", RowBox[{"3", " ", "->", " ", RowBox[{"d", " ", "+", " ", "1"}]}]}], "]"}], "]"}], ",", " ", "level"}], "}"}]}]], "Input"],

Cell[BoxData[RowBox[{RowBox[{"levels", " ", "=", " ", RowBox[{"BratteliLevelsWBA", "[", RowBox[{"n", ",", " ", "m", ",", " ", "d"}], "]"}]}], ";"}]], "Input"],

Cell[BoxData[RowBox[{RowBox[{"levelsND", " ", "=", "\n", "  ", RowBox[{"Table", "[", "\n", "    ", RowBox[{RowBox[{"Join", "[", "\n", "      ", RowBox[{RowBox[{"pad", " ", "/@", " ", RowBox[{"levels", "[", RowBox[{"[", RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], "\n", "      ", ",", "\n", "      ", RowBox[{"If", "[", RowBox[{RowBox[{"3", " ", "<=", " ", "i", " ", "<=", " ", "n"}], ",", "\n", "        ", RowBox[{"Cases", "[", RowBox[{RowBox[{"levels", "[", RowBox[{"[", "i", "]"}], "]"}], ",", " ", RowBox[{RowBox[{RowBox[{"{", RowBox[{"s_", ",", " ", "_"}], "}"}], " ", "/;", " ", RowBox[{"AllTrue", "[", RowBox[{"s", ",", " ", "Positive"}], "]"}]}], " ", ":>", " ", RowBox[{"{", RowBox[{RowBox[{"Append", "[", RowBox[{"s", ",", " ", "1"}], "]"}], ",", " ", "i"}], "}"}]}]}], "\n", "          ", "]"}], "\n", "        ", ",", "\n", "        ", RowBox[{"{", "}"}]}], "\n", "      ", "]"}]}], "\n", "    ", "]"}], "\n", "    ", ",", "\n", "    ", RowBox[{"{", RowBox[{"i", ",", " ", "0", ",", " ", RowBox[{"n", " ", "+", " ", "m"}]}], "}"}]}], "\n", "  ", "]"}]}], ";"}]], "Input"],

Cell[BoxData[RowBox[{RowBox[{"pathsND", " ", "=", " ", RowBox[{"AllPathsWBA", "[", "levelsND", "]"}]}], ";"}]], "Input"],

Cell["The number of vertices on each level and the dimensions of the irreps, without and with the dilation:", "Text"],

Cell[BoxData[RowBox[{"Grid", "[", RowBox[{RowBox[{"Prepend", "[", RowBox[{RowBox[{"Transpose", "[", RowBox[{"{", RowBox[{RowBox[{"Range", "[", RowBox[{"0", ",", " ", RowBox[{"n", " ", "+", " ", "m"}]}], "]"}], ",", " ", RowBox[{"Length", " ", "/@", " ", "levels"}], ",", " ", RowBox[{"Length", " ", "/@", " ", "levelsND"}]}], "}"}], "]"}], ",", "\n", "   ", RowBox[{"{", RowBox[{"\"level\"", ",", " ", "\"original\"", ",", " ", "\"dilated\""}], "}"}]}], "]"}], ",", " ", RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]], "Input"],

Cell[BoxData[RowBox[{"Grid", "[", RowBox[{RowBox[{"Prepend", "[", RowBox[{RowBox[{"Transpose", "[", RowBox[{"{", RowBox[{RowBox[{"DisplayStaircase", " ", "/@", " ", "irreps"}], ",", " ", RowBox[{"IrrepDimsWBA", "[", RowBox[{"n", ",", " ", "m", ",", " ", "d"}], "]"}], ",", " ", RowBox[{"Length", "\n", "   ", "/@", " ", "pathsND"}]}], "}"}], "]"}], ",", " ", RowBox[{"{", RowBox[{"\"irrep\"", ",", " ", "\"original\"", ",", " ", "\"dilated\""}], "}"}]}], "]"}], ",", " ", RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]], "Input"],

Cell["The basis vectors of the usual and of the dilated Gelfand-Tsetlin basis, as pairs of mixed Young tableaux:", "Text"],

Cell[BoxData[RowBox[{"pathsByIrrepView", "[", RowBox[{RowBox[{"AllPathsWBA", "[", RowBox[{"n", ",", " ", "m", ",", " ", "d"}], "]"}], ",", " ", "irreps"}], "]"}]], "Input"],

Cell[BoxData[RowBox[{"pathsByIrrepView", "[", RowBox[{"pathsND", ",", " ", "irreps"}], "]"}]], "Input"],

Cell["The generators in the dilated basis still satisfy the relations of the walled Brauer algebra:", "Text"],

Cell[BoxData[RowBox[{RowBox[{"gensND", " ", "=", " ", RowBox[{"GeneratorsGT", "[", RowBox[{"n", ",", " ", "m", ",", " ", "d", ",", " ", "pathsND"}], "]"}]}], ";"}]], "Input"],

Cell[BoxData[RowBox[{"AllTrue", "[", RowBox[{RowBox[{"Flatten", "[", RowBox[{"Table", "[", RowBox[{RowBox[{"Values", "[", RowBox[{"CheckRelationsWBA", "[", RowBox[{RowBox[{"gensND", "[", RowBox[{"[", RowBox[{"All", ",", " ", "l"}], "]"}], "]"}], ",", " ", "n", ",", " ", "m", ",", " ", "d"}], "]"}], "]"}], ",", " ", RowBox[{"{", RowBox[{"l", ",", "\n", "   ", RowBox[{"Length", "[", "pathsND", "]"}]}], "}"}]}], "]"}], "]"}], ",", " ", "TrueQ"}], "]"}]], "Input"],

Cell[TextData[{"In the dilated basis, the measurement element for port n becomes the projector obtained from the contraction by replacing the weights (d + c(a)) ", StyleBox["TransitionWeight", FontFamily -> "Courier"], "[μ, a] by the transition probabilities ", StyleBox["TransitionWeight", FontFamily -> "Courier"], "[μ, a]. Moving it to the other ports gives a projective measurement:"}], "Text"],

Cell[BoxData[RowBox[{RowBox[{"projectorND", " ", "=", " ", RowBox[{"ContractionGT", "[", RowBox[{"n", ",", " ", "m", ",", " ", "d", ",", " ", "pathsND", ",", " ", RowBox[{"\"Weight\"", " ", "->", " ", "TransitionWeight"}]}], "]"}]}], ";"}]], "Input"],

Cell[BoxData[RowBox[{RowBox[{"pvm", " ", "=", " ", RowBox[{"Table", "[", RowBox[{RowBox[{"Simplify", "[", RowBox[{"moveToPort", "[", RowBox[{"k", ",", " ", RowBox[{"gensND", "[", RowBox[{"[", RowBox[{"All", ",", " ", "l"}], "]"}], "]"}], ",", " ", RowBox[{"projectorND", "[", RowBox[{"[", "l", "]"}], "]"}]}], "]"}], "]"}], ",", " ", RowBox[{"{", RowBox[{"l", ",", " ", RowBox[{"Length", "[", "\n", "  ", "pathsND", "]"}]}], "}"}], ",", " ", RowBox[{"{", RowBox[{"k", ",", " ", "n"}], "}"}]}], "]"}]}], ";"}]], "Input"],

Cell["All its elements commute, and their eigenvalues are 0 and 1:", "Text"],

Cell[BoxData[RowBox[{"commutationView", "[", RowBox[{"pvm", ",", " ", "irreps"}], "]"}]], "Input"],

Cell[BoxData[RowBox[{"spectrumView", "[", RowBox[{"pvm", ",", " ", "irreps"}], "]"}]], "Input"]
},
CellContext -> Notebook,
ShowAutoSpellCheck -> False,
WindowSize -> {1120, 820},
StyleDefinitions -> "Default.nb"
]
