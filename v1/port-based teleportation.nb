(* Content-type: application/vnd.wolfram.mathematica *)

(*** Wolfram Notebook File ***)
(* http://www.wolfram.com/nb *)

Notebook[{
Cell["Port-based teleportation in the Gelfand-Tsetlin basis", "Title"],

Cell["Pretty good measurement and its Naimark dilation", "Subtitle"],

Cell[TextData[{"This notebook accompanies arXiv:2310.02252. In port-based teleportation the sender and the receiver share n maximally entangled pairs of dimension d, and the receiver's halves are the ports. The sender measures the other n halves together with the system to be teleported, which enters through the dual representation. The relevant algebra is therefore the algebra of partially transposed permutations with n left and m = 1 right tensor factors. All computations below use the functions of ", StyleBox["Mixed Schur Tools.wl", FontFamily->"Courier"], "."}], "Text"],

Cell["Setup", "Section"],

Cell[BoxData[RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"ParentDirectory", "[", RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ",", "\"Mixed Schur Tools.wl\""}], "}"}], "]"}], "]"}]], "Input", InitializationCell->True],

Cell["Four ports of dimension three and one dual system:", "Text"],

Cell[BoxData[{RowBox[{"{", RowBox[{"n", ",", "m", ",", "d"}], "}", "=", "{", RowBox[{"4", ",", "1", ",", "3"}], "}", ";"}], "\[IndentingNewLine]", RowBox[{"irreps", "=", "Irreps", "[", RowBox[{"n", ",", "m", ",", "d"}], "]", ";"}]}], "Input"],

Cell["The irreps, drawn as staircases (right partition to the left of the wall), and the dimensions of the corresponding irreps of the walled Brauer algebra:", "Text"],

Cell[BoxData[RowBox[{"Grid", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"DisplayStaircase", "/@", "irreps"}], ",", RowBox[{"IrrepDimsWBA", "[", RowBox[{"n", ",", "m", ",", "d"}], "]"}]}], "}"}], ",", RowBox[{"Frame", "->", "All"}]}], "]"}]], "Input"],

Cell["Generators in the Gelfand-Tsetlin basis", "Section"],

Cell[TextData[{StyleBox["GeneratorsGT", FontFamily->"Courier"], " gives the matrices of the transpositions \[Sigma]_1, \[Ellipsis], \[Sigma]_(n-1) and of the contraction \[Sigma]_n in every irrep, indexed as [[generator, irrep]]. They satisfy the relations of the walled Brauer algebra:"}], "Text"],

Cell[BoxData[{RowBox[{"gens", "=", "GeneratorsGT", "[", RowBox[{"n", ",", "m", ",", "d"}], "]", ";"}], "\[IndentingNewLine]", RowBox[{"AllTrue", "[", RowBox[{RowBox[{"Flatten", "@", "Table", "[", RowBox[{RowBox[{"Values", "@", "CheckRelationsWBA", "[", RowBox[{RowBox[{"gens", "[", RowBox[{"[", RowBox[{"All", ",", "l"}], "]"}], "]"}], ",", "n", ",", "m", ",", "d"}], "]"}], ",", RowBox[{"{", RowBox[{"l", ",", RowBox[{"Length", "@", "irreps"}]}], "}"}]}], "]"}], ",", "TrueQ"}], "]"}]}], "Input"],

Cell["Pretty good measurement", "Section"],

Cell[TextData[{"The permutation \[Pi]_k = \[Sigma]_k \[Sigma]_(k+1) \[Ellipsis] \[Sigma]_(n-1) moves port k to port n, so that \[Rho]_k = \[Pi]_k \[Sigma]_n \[Pi]_k^T contracts port k with the dual system. ", StyleBox["moveToPort", FontFamily->"Courier"], " conjugates an operator on port n in this way, given the generator matrices \[Sigma] of one irrep:"}], "Text"],

Cell[BoxData[RowBox[{"moveToPort", "[", RowBox[{"k_", ",", "\[Sigma]_", ",", "a_"}], "]", ":=", "With", "[", RowBox[{RowBox[{"{", RowBox[{"\[Pi]", "=", "Fold", "[", RowBox[{"Dot", ",", RowBox[{"IdentityMatrix", "@", "Length", "@", "a"}], ",", RowBox[{"\[Sigma]", "[", RowBox[{"[", RowBox[{"k", ";;", "n", "-", "1"}], "]"}], "]"}]}], "]"}], "}"}], ",", RowBox[{"\[Pi]", ".", "a", ".", "Transpose", "[", "\[Pi]", "]"}]}], "]"}]], "Input"],

Cell["In an irrep without right partition, the elements of the pretty good measurement are E_k = \[Rho]^(-1/2) \[Rho]_k \[Rho]^(-1/2) with \[Rho] = \[Rho]_1 + \[Ellipsis] + \[Rho]_n; in the other irreps they vanish.", "Text"],

Cell[BoxData[{RowBox[{"pgm", "[", RowBox[{"\[Sigma]_", ",", "irrep_"}], "]", ":=", "Module", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"\[Rho]", "=", "Table", "[", RowBox[{RowBox[{"moveToPort", "[", RowBox[{"k", ",", "\[Sigma]", ",", RowBox[{"\[Sigma]", "[", RowBox[{"[", "n", "]"}], "]"}]}], "]"}], ",", RowBox[{"{", RowBox[{"k", ",", "n"}], "}"}]}], "]"}], ",", "inverseSqrt"}], "}"}], ",", RowBox[{"\[IndentingNewLine]", "If", "[", RowBox[{RowBox[{"AnyTrue", "[", RowBox[{"irrep", ",", "Negative"}], "]"}], ",", RowBox[{"\[IndentingNewLine]", "0", " ", "\[Rho]"}], ",", RowBox[{"\[IndentingNewLine]", "inverseSqrt", "=", "MatrixPower", "[", RowBox[{RowBox[{"Total", "@", "\[Rho]"}], ",", RowBox[{"-", "1", "/", "2"}]}], "]", ";", "\[IndentingNewLine]", "Simplify", "[", RowBox[{"inverseSqrt", ".", "#", ".", "inverseSqrt"}], "]", "&", "/@", "\[Rho]", "\[IndentingNewLine]"}]}], "]", "\[IndentingNewLine]"}]}], "]"}], "\[IndentingNewLine]", RowBox[{"povm", "=", "Table", "[", RowBox[{RowBox[{"pgm", "[", RowBox[{RowBox[{"gens", "[", RowBox[{"[", RowBox[{"All", ",", "l"}], "]"}], "]"}], ",", RowBox[{"irreps", "[", RowBox[{"[", "l", "]"}], "]"}]}], "]"}], ",", RowBox[{"{", RowBox[{"l", ",", RowBox[{"Length", "@", "irreps"}]}], "}"}]}], "]", ";"}]}], "Input"],

Cell["For every irrep, whether the measurement elements E_i and E_j commute, for 1 \[LessEqual] i \[LessEqual] j \[LessEqual] n. In the last irrep some of them do not:", "Text"],

Cell[BoxData[{RowBox[{"commuteQ", "[", RowBox[{"a_", ",", "b_"}], "]", ":=", "AllTrue", "[", RowBox[{RowBox[{"Flatten", "@", "Normal", "[", RowBox[{"a", ".", "b", "-", "b", ".", "a"}], "]"}], ",", "PossibleZeroQ"}], "]"}], "\[IndentingNewLine]", RowBox[{"Table", "[", RowBox[{RowBox[{"Flatten", "@", "Table", "[", RowBox[{RowBox[{"commuteQ", "[", RowBox[{RowBox[{"povm", "[", RowBox[{"[", RowBox[{"l", ",", "i"}], "]"}], "]"}], ",", RowBox[{"povm", "[", RowBox[{"[", RowBox[{"l", ",", "j"}], "]"}], "]"}]}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", "n"}], "}"}], ",", RowBox[{"{", RowBox[{"j", ",", "i", ",", "n"}], "}"}]}], "]"}], ",", RowBox[{"{", RowBox[{"l", ",", RowBox[{"Length", "@", "irreps"}]}], "}"}]}], "]", "//", "TableForm"}]}], "Input"],

Cell["Their eigenvalues:", "Text"],

Cell[BoxData[RowBox[{"Table", "[", RowBox[{RowBox[{"Chop", "[", RowBox[{"Eigenvalues", "/@", "N", "@", "povm", "[", RowBox[{"[", "l", "]"}], "]"}], "]", "//", "TableForm"}], ",", RowBox[{"{", RowBox[{"l", ",", RowBox[{"Length", "@", "irreps"}]}], "}"}]}], "]", "//", "TableForm"}]], "Input"],

Cell["Naimark dilation", "Section"],

Cell["The Naimark dilation enlarges the Gelfand-Tsetlin basis without changing the irreps. At each left level i = 3, \[Ellipsis], n of the Bratteli diagram, every partition with d rows on level i - 1 gets an extra vertex on level i, with one more cell in row d + 1. To hold these vertices, all staircases are padded to length d + 1.", "Text"],

Cell[BoxData[{RowBox[{"pad", "[", RowBox[{"{", RowBox[{"s_", ",", "level_"}], "}"}], "]", ":=", "{", RowBox[{RowBox[{"ToStaircase", "[", RowBox[{"ReplacePart", "[", RowBox[{RowBox[{"ToPair", "@", "s"}], ",", RowBox[{"3", "->", "d", "+", "1"}]}], "]"}], "]"}], ",", "level"}], "}"}], "\[IndentingNewLine]", RowBox[{"levels", "=", "BratteliLevelsWBA", "[", RowBox[{"n", ",", "m", ",", "d"}], "]", ";"}], "\[IndentingNewLine]", RowBox[{"levelsND", "=", "Table", "[", RowBox[{RowBox[{"\[IndentingNewLine]", "Join", "[", RowBox[{RowBox[{"\[IndentingNewLine]", "pad", "/@", "levels", "[", RowBox[{"[", RowBox[{"i", "+", "1"}], "]"}], "]"}], ",", RowBox[{"\[IndentingNewLine]", "If", "[", RowBox[{RowBox[{"3", "<=", "i", "<=", "n"}], ",", RowBox[{"Cases", "[", RowBox[{RowBox[{"levels", "[", RowBox[{"[", "i", "]"}], "]"}], ",", RowBox[{"{", RowBox[{"s_", ",", "_"}], "}", "/;", "AllTrue", "[", RowBox[{"s", ",", "Positive"}], "]", ":>", "{", RowBox[{RowBox[{"Append", "[", RowBox[{"s", ",", "1"}], "]"}], ",", "i"}], "}"}]}], "]"}], ",", RowBox[{"{", "}"}]}], "]", "\[IndentingNewLine]"}]}], "]"}], ",", RowBox[{"\[IndentingNewLine]", "{", RowBox[{"i", ",", "0", ",", RowBox[{"n", "+", "m"}]}], "}", "\[IndentingNewLine]"}]}], "]", ";"}], "\[IndentingNewLine]", RowBox[{"pathsND", "=", "AllPathsWBA", "[", "levelsND", "]", ";"}]}], "Input"],

Cell["The number of vertices on each level and the dimensions of the irreps, without and with the dilation:", "Text"],

Cell[BoxData[{RowBox[{"{", RowBox[{RowBox[{"Length", "/@", "levels"}], ",", RowBox[{"Length", "/@", "levelsND"}]}], "}"}], "\[IndentingNewLine]", RowBox[{"{", RowBox[{RowBox[{"IrrepDimsWBA", "[", RowBox[{"n", ",", "m", ",", "d"}], "]"}], ",", RowBox[{"Length", "/@", "pathsND"}]}], "}"}]}], "Input"],

Cell["The basis vectors of the usual and of the dilated Gelfand-Tsetlin basis, as pairs of mixed Young tableaux:", "Text"],

Cell[BoxData[{RowBox[{"Map", "[", RowBox[{"DisplayPath", ",", RowBox[{"AllPathsWBA", "[", RowBox[{"n", ",", "m", ",", "d"}], "]"}], ",", RowBox[{"{", "2", "}"}]}], "]", "//", "TableForm"}], "\[IndentingNewLine]", RowBox[{"Map", "[", RowBox[{"DisplayPath", ",", "pathsND", ",", RowBox[{"{", "2", "}"}]}], "]", "//", "TableForm"}]}], "Input"],

Cell["The generators in the dilated basis still satisfy the relations of the walled Brauer algebra:", "Text"],

Cell[BoxData[{RowBox[{"gensND", "=", "GeneratorsGT", "[", RowBox[{"n", ",", "m", ",", "d", ",", "pathsND"}], "]", ";"}], "\[IndentingNewLine]", RowBox[{"AllTrue", "[", RowBox[{RowBox[{"Flatten", "@", "Table", "[", RowBox[{RowBox[{"Values", "@", "CheckRelationsWBA", "[", RowBox[{RowBox[{"gensND", "[", RowBox[{"[", RowBox[{"All", ",", "l"}], "]"}], "]"}], ",", "n", ",", "m", ",", "d"}], "]"}], ",", RowBox[{"{", RowBox[{"l", ",", RowBox[{"Length", "@", "pathsND"}]}], "}"}]}], "]"}], ",", "TrueQ"}], "]"}]}], "Input"],

Cell[TextData[{"In the dilated basis, the measurement element for port n becomes the projector obtained from the contraction by replacing the weights (d + c(a)) ", StyleBox["TransitionWeight", FontFamily->"Courier"], "[\[Mu], a] by the transition probabilities ", StyleBox["TransitionWeight", FontFamily->"Courier"], "[\[Mu], a]. Moving it to the other ports gives a projective measurement:"}], "Text"],

Cell[BoxData[{RowBox[{"projectorND", "=", "ContractionGT", "[", RowBox[{"n", ",", "m", ",", "d", ",", "pathsND", ",", RowBox[{"\"Weight\"", "->", "TransitionWeight"}]}], "]", ";"}], "\[IndentingNewLine]", RowBox[{"pvm", "=", "Table", "[", RowBox[{RowBox[{"Simplify", "[", RowBox[{"moveToPort", "[", RowBox[{"k", ",", RowBox[{"gensND", "[", RowBox[{"[", RowBox[{"All", ",", "l"}], "]"}], "]"}], ",", RowBox[{"projectorND", "[", RowBox[{"[", "l", "]"}], "]"}]}], "]"}], "]"}], ",", RowBox[{"{", RowBox[{"l", ",", RowBox[{"Length", "@", "pathsND"}]}], "}"}], ",", RowBox[{"{", RowBox[{"k", ",", "n"}], "}"}]}], "]", ";"}]}], "Input"],

Cell["All its elements commute, and their eigenvalues are 0 and 1:", "Text"],

Cell[BoxData[{RowBox[{"Table", "[", RowBox[{RowBox[{"Flatten", "@", "Table", "[", RowBox[{RowBox[{"commuteQ", "[", RowBox[{RowBox[{"pvm", "[", RowBox[{"[", RowBox[{"l", ",", "i"}], "]"}], "]"}], ",", RowBox[{"pvm", "[", RowBox[{"[", RowBox[{"l", ",", "j"}], "]"}], "]"}]}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", "n"}], "}"}], ",", RowBox[{"{", RowBox[{"j", ",", "i", ",", "n"}], "}"}]}], "]"}], ",", RowBox[{"{", RowBox[{"l", ",", RowBox[{"Length", "@", "pathsND"}]}], "}"}]}], "]", "//", "TableForm"}], "\[IndentingNewLine]", RowBox[{"Table", "[", RowBox[{RowBox[{"Chop", "[", RowBox[{"Eigenvalues", "/@", "N", "@", "pvm", "[", RowBox[{"[", "l", "]"}], "]"}], "]", "//", "TableForm"}], ",", RowBox[{"{", RowBox[{"l", ",", RowBox[{"Length", "@", "pathsND"}]}], "}"}]}], "]", "//", "TableForm"}]}], "Input"]
},
StyleDefinitions->"Default.nb"
]
