(* Content-type: application/vnd.wolfram.mathematica *)

(*** Wolfram Notebook File ***)

Notebook[{
Cell["Gelfand-Tsetlin basis of the partially transposed permutations", "Title"],

Cell["Bratteli diagram, irreps, mixed Young tableaux and generators", "Subtitle"],

Cell[TextData[{"This notebook accompanies arXiv:2310.02252. The algebra of partially transposed permutations acts on a mixed tensor space with n left and m dual factors of dimension d. It permutes the first n and the last m factors, and contracts factors n and n + 1 through the generator σ_n. Its Gelfand-Tsetlin basis is labelled by paths in the Bratteli diagram, or equivalently by pairs of mixed Young tableaux. All computations below use the functions of ", StyleBox["Mixed Schur Tools.wl", FontFamily -> "Courier"], "."}], "Text"],

Cell["Setup", "Section"],

Cell["Choose Evaluation > Evaluate Notebook to run all examples from the top. The setup loads the package and the default parameters. Display helpers are grouped below; open that group only if you want to customize the presentation.", "Text"],

Cell[BoxData[RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"ParentDirectory", "[", RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ",", " ", "\"Mixed Schur Tools.wl\""}], "}"}], "\n", "  ", "]"}], "]"}]], "Input", InitializationCell -> True],

Cell["Three left and two right tensor factors of dimension three:", "Text"],

Cell[BoxData[RowBox[{RowBox[{RowBox[{"{", RowBox[{"n", ",", " ", "m", ",", " ", "d"}], "}"}], " ", "=", " ", RowBox[{"{", RowBox[{"3", ",", " ", "2", ",", " ", "3"}], "}"}]}], ";"}]], "Input", InitializationCell -> True],

Cell[CellGroupData[{Cell["Display helpers", "Subsection"], Cell[BoxData[RowBox[{RowBox[{"matrixView", "[", "a_", "]"}], " ", ":=", "\n", "  ", RowBox[{"MatrixForm", "[", "\n", "    ", RowBox[{RowBox[{"Map", "[", "\n", "      ", RowBox[{RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"TrueQ", "[", RowBox[{"#1", " ", "==", " ", "0"}], "]"}], ",", "\n", "        ", RowBox[{"Style", "[", RowBox[{"0", ",", " ", RowBox[{"GrayLevel", "[", "0.55", "]"}]}], "]"}], "\n", "        ", ",", "\n", "        ", "#1"}], "\n", "      ", "]"}], "&"}], "\n", "      ", ",", "\n", "      ", RowBox[{"Simplify", "[", RowBox[{"Normal", "[", "a", "]"}], "]"}], "\n", "      ", ",", "\n", "      ", RowBox[{"{", "2", "}"}]}], "\n", "    ", "]"}], "\n", "    ", ",", "\n", "    ", RowBox[{"TableSpacing", " ", "->", " ", RowBox[{"{", RowBox[{"0.7", ",", " ", "1.3"}], "}"}]}]}], "\n", "  ", "]"}]}]], "Input", InitializationCell -> True], Cell[BoxData[RowBox[{RowBox[{"pathView", "[", "paths_", "]"}], " ", ":=", "\n", "  ", RowBox[{"Grid", "[", RowBox[{RowBox[{"Partition", "[", RowBox[{RowBox[{"MapIndexed", "[", RowBox[{RowBox[{RowBox[{"Column", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"Style", "[", RowBox[{RowBox[{"Row", "[", RowBox[{"{", RowBox[{"\"path \"", ",", " ", RowBox[{"First", "[", "#2", "]"}]}], "}"}], "]"}], ",", " ", "Small"}], "]"}], ",", " ", RowBox[{"DisplayPath", "[", "\n", "    ", "#1", "]"}]}], "}"}], ",", " ", RowBox[{"Alignment", " ", "->", " ", "Center"}], ",", " ", RowBox[{"Spacings", " ", "->", " ", "0.6"}]}], "]"}], "&"}], ",", " ", "paths"}], "]"}], ",", " ", RowBox[{"UpTo", "[", "3", "]"}]}], "]"}], ",", " ", RowBox[{"Alignment", " ", "->", " ", "Center"}], ",", "\n", "     ", RowBox[{"Spacings", " ", "->", " ", RowBox[{"{", RowBox[{"2", ",", " ", "1.2"}], "}"}]}]}], "]"}]}]], "Input", InitializationCell -> True], Cell[BoxData[RowBox[{RowBox[{"pathsByIrrepView", "[", RowBox[{"groups_", ",", " ", "labels_"}], "]"}], " ", ":=", "\n", "  ", RowBox[{"Column", "[", RowBox[{RowBox[{"MapThread", "[", RowBox[{RowBox[{RowBox[{"Column", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"Row", "[", RowBox[{"{", RowBox[{"\"Irrep \"", ",", " ", RowBox[{"DisplayStaircase", "[", "#2", "]"}]}], "}"}], "]"}], ",", " ", RowBox[{"pathView", "[", "#1", "]"}]}], "}"}], ",", "\n", "     ", RowBox[{"Spacings", " ", "->", " ", "0.8"}]}], "]"}], "&"}], ",", " ", RowBox[{"{", RowBox[{"groups", ",", " ", "labels"}], "}"}]}], "]"}], ",", " ", RowBox[{"Spacings", " ", "->", " ", "2"}]}], "]"}]}]], "Input", InitializationCell -> True], Cell[BoxData[RowBox[{RowBox[{"generatorView", "[", RowBox[{"generators_", ",", " ", "labels_"}], "]"}], " ", ":=", "\n", "  ", RowBox[{"Column", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"Column", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"Row", "[", RowBox[{"{", RowBox[{"\"Irrep \"", ",", " ", RowBox[{"DisplayStaircase", "[", RowBox[{"labels", "[", RowBox[{"[", "l", "]"}], "]"}], "]"}], ",", " ", RowBox[{"Spacer", "[", "16", "]"}], ",", "\n", "     ", "\"dimension \"", ",", " ", RowBox[{"Length", "[", RowBox[{"generators", "[", RowBox[{"[", RowBox[{"1", ",", " ", "l"}], "]"}], "]"}], "]"}]}], "}"}], "]"}], ",", " ", RowBox[{"Grid", "[", RowBox[{RowBox[{"Partition", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"Column", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"Subscript", "[", "\n", "    ", RowBox[{"\"σ\"", ",", " ", "i"}], "]"}], ",", " ", RowBox[{"matrixView", "[", RowBox[{"generators", "[", RowBox[{"[", RowBox[{"i", ",", " ", "l"}], "]"}], "]"}], "]"}]}], "}"}], ",", " ", RowBox[{"Alignment", " ", "->", " ", "Center"}], ",", " ", RowBox[{"Spacings", " ", "->", " ", "0.6"}]}], "]"}], ",", "\n", "     ", RowBox[{"{", RowBox[{"i", ",", " ", RowBox[{"Length", "[", "generators", "]"}]}], "}"}]}], "]"}], ",", " ", RowBox[{"UpTo", "[", "2", "]"}]}], "]"}], ",", " ", RowBox[{"Alignment", " ", "->", " ", "Center"}], ",", " ", RowBox[{"Spacings", " ", "->", " ", RowBox[{"{", RowBox[{"3", ",", " ", "1.8"}], "}"}]}]}], "]"}]}], "\n", "    ", "}"}], ",", " ", RowBox[{"Spacings", " ", "->", " ", "1"}]}], "]"}], ",", " ", RowBox[{"{", RowBox[{"l", ",", " ", RowBox[{"Length", "[", "labels", "]"}]}], "}"}]}], "]"}], ",", " ", RowBox[{"Spacings", " ", "->", " ", "3"}]}], "]"}]}]], "Input", InitializationCell -> True], Cell[BoxData[RowBox[{RowBox[{"relationView", "[", "relations_", "]"}], " ", ":=", "\n", "  ", RowBox[{"Grid", "[", RowBox[{RowBox[{"Prepend", "[", RowBox[{RowBox[{"KeyValueMap", "[", RowBox[{RowBox[{RowBox[{"{", RowBox[{RowBox[{"Pane", "[", RowBox[{"#1", ",", " ", RowBox[{"ImageSize", " ", "->", " ", RowBox[{"{", RowBox[{"420", ",", " ", "Automatic"}], "}"}]}]}], "]"}], ",", " ", RowBox[{"Row", "[", RowBox[{"{", RowBox[{RowBox[{"Count", "[", "\n", "    ", RowBox[{RowBox[{"Flatten", "[", RowBox[{"{", "#2", "}"}], "]"}], ",", " ", "True"}], "]"}], ",", " ", "\" / \"", ",", " ", RowBox[{"Length", "[", RowBox[{"Flatten", "[", RowBox[{"{", "#2", "}"}], "]"}], "]"}]}], "}"}], "]"}]}], "}"}], "&"}], ",", " ", "relations"}], "]"}], ",", " ", RowBox[{"{", RowBox[{"\"relation\"", ",", "\n", "     ", "\"checks passed\""}], "}"}]}], "]"}], ",", " ", RowBox[{"Alignment", " ", "->", " ", RowBox[{"{", RowBox[{"Left", ",", " ", "Center"}], "}"}]}], ",", " ", RowBox[{"Spacings", " ", "->", " ", RowBox[{"{", RowBox[{"1.5", ",", " ", "1"}], "}"}]}], ",", " ", RowBox[{"Dividers", "\n", "     ", "->", " ", RowBox[{"{", RowBox[{"False", ",", " ", RowBox[{"{", RowBox[{"2", " ", "->", " ", "True"}], "}"}]}], "}"}]}]}], "]"}]}]], "Input", InitializationCell -> True]}, Closed]],

Cell["Bratteli diagram", "Section"],

Cell[TextData[{"Each vertex is a staircase: a non-increasing list of d integers, whose positive entries form the left partition and whose negative entries form the reversed right partition. ", StyleBox["DisplayStaircase", FontFamily -> "Courier"], " draws the right partition to the left of a thick wall. Levels 1, …, n add a cell to the left partition; levels n + 1, …, n + m either add a cell to the right partition or remove one from the left partition."}], "Text"],

Cell[BoxData[RowBox[{"BratteliDiagramWBALabelled", "[", RowBox[{"n", ",", " ", "m", ",", " ", "d"}], "]"}]], "Input"],

Cell[TextData[{"In the more compact ", StyleBox["BratteliDiagramWBA", FontFamily -> "Courier"], ", hover over a vertex to see its staircase:"}], "Text"],

Cell[BoxData[RowBox[{"BratteliDiagramWBA", "[", RowBox[{"n", ",", " ", "m", ",", " ", "d"}], "]"}]], "Input"],

Cell["Irreps and the Gelfand-Tsetlin basis", "Section"],

Cell["The irreps are the vertices of the last level. Their dimensions are the numbers of paths leading to them:", "Text"],

Cell[BoxData[RowBox[{RowBox[{"irreps", " ", "=", " ", RowBox[{"Irreps", "[", RowBox[{"n", ",", " ", "m", ",", " ", "d"}], "]"}]}], ";"}]], "Input"],

Cell[BoxData[RowBox[{"Grid", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"DisplayStaircase", " ", "/@", " ", "irreps"}], ",", " ", RowBox[{"IrrepDimsWBA", "[", RowBox[{"n", ",", " ", "m", ",", " ", "d"}], "]"}]}], "}"}], ",", " ", RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]], "Input"],

Cell["Every path is equivalent to a pair of mixed Young tableaux. A step i that adds a cell labels it by i; a step that removes a cell from the left partition appends its number to the label of that cell. Each row below lists the Gelfand-Tsetlin basis of one irrep:", "Text"],

Cell[BoxData[RowBox[{"pathsByIrrepView", "[", RowBox[{RowBox[{"AllPathsWBA", "[", RowBox[{"n", ",", " ", "m", ",", " ", "d"}], "]"}], ",", " ", "irreps"}], "]"}]], "Input"],

Cell["The tableaux themselves are available as data:", "Text"],

Cell[BoxData[RowBox[{"PathToYoungTableaux", "[", RowBox[{RowBox[{"AllPathsWBA", "[", RowBox[{"n", ",", " ", "m", ",", " ", "d"}], "]"}], "[", RowBox[{"[", RowBox[{"4", ",", " ", "1"}], "]"}], "]"}], "]"}]], "Input"],

Cell["Generators in the Gelfand-Tsetlin basis", "Section"],

Cell[TextData[{StyleBox["GeneratorsGT", FontFamily -> "Courier"], " gives the matrices of the transpositions σ_i, i ≠ n, and of the contraction σ_n in every irrep. The matrices are grouped by irrep, with each generator labelled above its matrix:"}], "Text"],

Cell[BoxData[RowBox[{RowBox[{"gens", " ", "=", " ", RowBox[{"GeneratorsGT", "[", RowBox[{"n", ",", " ", "m", ",", " ", "d"}], "]"}]}], ";"}]], "Input"],

Cell[BoxData[RowBox[{"generatorView", "[", RowBox[{"gens", ",", " ", "irreps"}], "]"}]], "Input"],

Cell[TextData[{StyleBox["CheckRelationsWBA", FontFamily -> "Courier"], " checks all defining relations of the walled Brauer algebra in one irrep:"}], "Text"],

Cell[BoxData[RowBox[{"relationView", "[", RowBox[{"CheckRelationsWBA", "[", RowBox[{RowBox[{"gens", "[", RowBox[{"[", RowBox[{"All", ",", " ", "4"}], "]"}], "]"}], ",", " ", "n", ",", " ", "m", ",", " ", "d"}], "]"}], "]"}]], "Input"],

Cell["They hold in every irrep:", "Text"],

Cell[BoxData[RowBox[{"AllTrue", "[", RowBox[{RowBox[{"Flatten", "[", RowBox[{"Table", "[", RowBox[{RowBox[{"Values", "[", RowBox[{"CheckRelationsWBA", "[", RowBox[{RowBox[{"gens", "[", RowBox[{"[", RowBox[{"All", ",", " ", "l"}], "]"}], "]"}], ",", " ", "n", ",", " ", "m", ",", " ", "d"}], "]"}], "]"}], ",", " ", RowBox[{"{", RowBox[{"l", ",", " ", RowBox[{"Length", "[", "\n", "  ", "irreps", "]"}]}], "}"}]}], "]"}], "]"}], ",", " ", "TrueQ"}], "]"}]], "Input"],

Cell["The generators on the tensor space", "Section"],

Cell["The mixed Schur transform S block-diagonalizes the action of the algebra on the tensor space: S P_i S^T is the direct sum, over the irreps, of the Gelfand-Tsetlin matrices of σ_i tensored with the identity on the corresponding irrep of U(d). We check this on a smaller example, where P_i swaps the tensor factors i and i + 1, and P_n is the partial transpose of that swap.", "Text"],

Cell[BoxData[RowBox[{RowBox[{"tensorGenerator", "[", RowBox[{"i_", ",", " ", "n_", ",", " ", "m_", ",", " ", "d_"}], "]"}], " ", ":=", "\n", "  ", RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"strings", " ", "=", " ", RowBox[{"StandardBasis", "[", RowBox[{RowBox[{"n", " ", "+", " ", "m"}], ",", " ", "d"}], "]"}]}], ",", " ", RowBox[{"index", " ", "=", " ", RowBox[{RowBox[{RowBox[{"FromDigits", "[", RowBox[{RowBox[{"#1", " ", "-", " ", "1"}], ",", " ", "d"}], "]"}], " ", "+", " ", "1"}], "&"}]}]}], "}"}], ",", "\n", "    ", "\n", "    ", RowBox[{"SparseArray", "[", "\n", "      ", RowBox[{RowBox[{"Flatten", "[", "\n", "        ", RowBox[{"Table", "[", "\n", "          ", RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"i", " ", "!=", " ", "n"}], ",", "\n", "            ", RowBox[{RowBox[{"{", RowBox[{RowBox[{"index", "[", RowBox[{"ReplacePart", "[", RowBox[{"x", ",", " ", RowBox[{"{", RowBox[{RowBox[{"i", " ", "->", " ", RowBox[{"x", "[", RowBox[{"[", RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", " ", RowBox[{RowBox[{"i", " ", "+", " ", "1"}], " ", "->", " ", RowBox[{"x", "[", RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}]}], "]"}], "]"}], ",", " ", RowBox[{"index", "[", "x", "\n", "              ", "]"}]}], "}"}], " ", "->", " ", "1"}], "\n", "            ", ",", "\n", "            ", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"x", "[", RowBox[{"[", "n", "]"}], "]"}], " ", "==", " ", RowBox[{"x", "[", RowBox[{"[", RowBox[{"n", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", "\n", "              ", RowBox[{"Table", "[", RowBox[{RowBox[{RowBox[{"{", RowBox[{RowBox[{"index", "[", RowBox[{"ReplacePart", "[", RowBox[{"x", ",", " ", RowBox[{"{", RowBox[{RowBox[{"n", " ", "->", " ", "a"}], ",", " ", RowBox[{RowBox[{"n", " ", "+", " ", "1"}], " ", "->", " ", "a"}]}], "}"}]}], "]"}], "]"}], ",", " ", RowBox[{"index", "[", "x", "]"}]}], "}"}], " ", "->", " ", "\n", "                ", "1"}], ",", " ", RowBox[{"{", RowBox[{"a", ",", " ", "d"}], "}"}]}], "]"}], "\n", "              ", ",", "\n", "              ", RowBox[{"{", "}"}]}], "\n", "            ", "]"}]}], "\n", "          ", "]"}], "\n", "          ", ",", "\n", "          ", RowBox[{"{", RowBox[{"x", ",", " ", "strings"}], "}"}]}], "\n", "        ", "]"}], "\n", "      ", "]"}], "\n", "      ", ",", "\n", "      ", RowBox[{"{", RowBox[{RowBox[{"d", " ", "^", " ", RowBox[{"(", RowBox[{"n", " ", "+", " ", "m"}], ")"}]}], ",", " ", RowBox[{"d", " ", "^", " ", RowBox[{"(", RowBox[{"n", " ", "+", " ", "m"}], ")"}]}]}], "}"}]}], "\n", "    ", "]"}]}], "\n", "  ", "]"}]}]], "Input"],

Cell[BoxData[RowBox[{RowBox[{"blockDiagonal", "[", "blocks_", "]"}], " ", ":=", "\n", "  ", RowBox[{"SparseArray", "[", "\n", "    ", RowBox[{"ArrayFlatten", "[", "\n", "      ", RowBox[{"Table", "[", "\n", "        ", RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"i", " ", "==", " ", "j"}], ",", "\n", "          ", RowBox[{"blocks", "[", RowBox[{"[", "i", "]"}], "]"}], "\n", "          ", ",", "\n", "          ", "0"}], "\n", "        ", "]"}], "\n", "        ", ",", "\n", "        ", RowBox[{"{", RowBox[{"i", ",", " ", RowBox[{"Length", "[", "blocks", "]"}]}], "}"}], "\n", "        ", ",", "\n", "        ", RowBox[{"{", RowBox[{"j", ",", " ", RowBox[{"Length", "[", "blocks", "]"}]}], "}"}]}], "\n", "      ", "]"}], "\n", "    ", "]"}], "\n", "  ", "]"}]}]], "Input"],

Cell[BoxData[RowBox[{RowBox[{"zeroQ", "[", "a_", "]"}], " ", ":=", "\n", "  ", RowBox[{"AllTrue", "[", RowBox[{RowBox[{"Flatten", "[", RowBox[{"Normal", "[", "a", "]"}], "]"}], ",", " ", "PossibleZeroQ"}], "]"}]}]], "Input"],

Cell[BoxData[RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"n", " ", "=", " ", "2"}], ",", " ", RowBox[{"m", " ", "=", " ", "2"}], ",", " ", RowBox[{"d", " ", "=", " ", "2"}]}], "}"}], ",", "\n", "  ", RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"S", " ", "=", " ", RowBox[{"SchurTransform", "[", RowBox[{"n", ",", " ", "m", ",", " ", "d"}], "]"}]}], ",", " ", RowBox[{"gens", " ", "=", " ", RowBox[{"GeneratorsGT", "[", RowBox[{"n", ",", " ", "m", ",", " ", "d"}], "]"}]}]}], "}"}], ",", "\n", "    ", RowBox[{"Table", "[", RowBox[{RowBox[{"zeroQ", "[", RowBox[{RowBox[{"S", " ", ".", " ", RowBox[{"tensorGenerator", "[", RowBox[{"i", ",", " ", "n", ",", " ", "m", ",", " ", "d"}], "]"}], " ", ".", " ", RowBox[{"Transpose", "[", "S", "]"}]}], " ", "-", " ", RowBox[{"blockDiagonal", "[", "\n", "      ", RowBox[{"MapThread", "[", RowBox[{"KroneckerProduct", ",", " ", RowBox[{"{", RowBox[{RowBox[{"gens", "[", RowBox[{"[", "i", "]"}], "]"}], ",", " ", RowBox[{"IdentityMatrix", " ", "/@", " ", RowBox[{"IrrepDimsGL", "[", RowBox[{"n", ",", " ", "m", ",", " ", "d"}], "]"}]}]}], "}"}]}], "\n", "      ", "]"}], "]"}]}], "]"}], ",", " ", RowBox[{"{", RowBox[{"i", ",", " ", RowBox[{"n", " ", "+", " ", "m", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], "\n", "  ", "]"}]}], "\n", "]"}]], "Input"]
},
CellContext -> Notebook,
ShowAutoSpellCheck -> False,
