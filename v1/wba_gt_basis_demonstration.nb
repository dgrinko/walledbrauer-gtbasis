(* Content-type: application/vnd.wolfram.mathematica *)

(*** Wolfram Notebook File ***)
(* http://www.wolfram.com/nb *)

Notebook[{
Cell["Gelfand-Tsetlin basis of the partially transposed permutations", "Title"],

Cell["Bratteli diagram, irreps, mixed Young tableaux and generators", "Subtitle"],

Cell[TextData[{"This notebook accompanies arXiv:2310.02252. The algebra of partially transposed permutations acts on (\[DoubleStruckCapitalC]^d)^\[CircleTimes]n \[CircleTimes] (\[DoubleStruckCapitalC]^d*)^\[CircleTimes]m by permuting the first n and the last m tensor factors and by the contraction \[Sigma]_n of factors n and n + 1. Its Gelfand-Tsetlin basis is labelled by paths in the Bratteli diagram, or equivalently by pairs of mixed Young tableaux. All computations below use the functions of ", StyleBox["Mixed Schur Tools.wl", FontFamily->"Courier"], "."}], "Text"],

Cell["Setup", "Section"],

Cell[BoxData[RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"ParentDirectory", "[", RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ",", "\"Mixed Schur Tools.wl\""}], "}"}], "]"}], "]"}]], "Input", InitializationCell->True],

Cell["Three left and two right tensor factors of dimension three:", "Text"],

Cell[BoxData[RowBox[{"{", RowBox[{"n", ",", "m", ",", "d"}], "}", "=", "{", RowBox[{"3", ",", "2", ",", "3"}], "}", ";"}]], "Input"],

Cell["Bratteli diagram", "Section"],

Cell[TextData[{"Each vertex is a staircase: a non-increasing list of d integers, whose positive entries form the left partition and whose negative entries form the reversed right partition. ", StyleBox["DisplayStaircase", FontFamily->"Courier"], " draws the right partition to the left of a thick wall. Levels 1, \[Ellipsis], n add a cell to the left partition; levels n + 1, \[Ellipsis], n + m either add a cell to the right partition or remove one from the left partition."}], "Text"],

Cell[BoxData[RowBox[{"BratteliDiagramWBALabelled", "[", RowBox[{"n", ",", "m", ",", "d"}], "]"}]], "Input"],

Cell[TextData[{"In the more compact ", StyleBox["BratteliDiagramWBA", FontFamily->"Courier"], ", hover over a vertex to see its staircase:"}], "Text"],

Cell[BoxData[RowBox[{"BratteliDiagramWBA", "[", RowBox[{"n", ",", "m", ",", "d"}], "]"}]], "Input"],

Cell["Irreps and the Gelfand-Tsetlin basis", "Section"],

Cell["The irreps are the vertices of the last level. Their dimensions are the numbers of paths leading to them:", "Text"],

Cell[BoxData[{RowBox[{"irreps", "=", "Irreps", "[", RowBox[{"n", ",", "m", ",", "d"}], "]", ";"}], "\[IndentingNewLine]", RowBox[{"Grid", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"DisplayStaircase", "/@", "irreps"}], ",", RowBox[{"IrrepDimsWBA", "[", RowBox[{"n", ",", "m", ",", "d"}], "]"}]}], "}"}], ",", RowBox[{"Frame", "->", "All"}]}], "]"}]}], "Input"],

Cell["Every path is equivalent to a pair of mixed Young tableaux. A step i that adds a cell labels it by i; a step that removes a cell from the left partition appends its number to the label of that cell. Each row below lists the Gelfand-Tsetlin basis of one irrep:", "Text"],

Cell[BoxData[RowBox[{"Map", "[", RowBox[{"DisplayPath", ",", RowBox[{"AllPathsWBA", "[", RowBox[{"n", ",", "m", ",", "d"}], "]"}], ",", RowBox[{"{", "2", "}"}]}], "]", "//", "TableForm"}]], "Input"],

Cell["The tableaux themselves are available as data:", "Text"],

Cell[BoxData[RowBox[{"PathToYoungTableaux", "[", RowBox[{"AllPathsWBA", "[", RowBox[{"n", ",", "m", ",", "d"}], "]", "[", RowBox[{"[", RowBox[{"4", ",", "1"}], "]"}], "]"}], "]"}]], "Input"],

Cell["Generators in the Gelfand-Tsetlin basis", "Section"],

Cell[TextData[{StyleBox["GeneratorsGT", FontFamily->"Courier"], " gives the matrices of the transpositions \[Sigma]_i, i \[NotEqual] n, and of the contraction \[Sigma]_n in every irrep. Each row of the table is a generator and each column an irrep:"}], "Text"],

Cell[BoxData[{RowBox[{"gens", "=", "GeneratorsGT", "[", RowBox[{"n", ",", "m", ",", "d"}], "]", ";"}], "\[IndentingNewLine]", RowBox[{"TableForm", "[", RowBox[{RowBox[{"Map", "[", RowBox[{"MatrixForm", ",", "gens", ",", RowBox[{"{", "2", "}"}]}], "]"}], ",", RowBox[{"\[IndentingNewLine]", "TableHeadings", "->", "{", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"Subscript", "[", RowBox[{"\"\[Sigma]\"", ",", "i"}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", RowBox[{"n", "+", "m", "-", "1"}]}], "}"}]}], "]"}], ",", RowBox[{"DisplayStaircase", "/@", "irreps"}]}], "}"}]}], "]"}]}], "Input"],

Cell[TextData[{StyleBox["CheckRelationsWBA", FontFamily->"Courier"], " checks all defining relations of the walled Brauer algebra in one irrep:"}], "Text"],

Cell[BoxData[RowBox[{"CheckRelationsWBA", "[", RowBox[{RowBox[{"gens", "[", RowBox[{"[", RowBox[{"All", ",", "4"}], "]"}], "]"}], ",", "n", ",", "m", ",", "d"}], "]"}]], "Input"],

Cell["They hold in every irrep:", "Text"],

Cell[BoxData[RowBox[{"AllTrue", "[", RowBox[{RowBox[{"Flatten", "@", "Table", "[", RowBox[{RowBox[{"Values", "@", "CheckRelationsWBA", "[", RowBox[{RowBox[{"gens", "[", RowBox[{"[", RowBox[{"All", ",", "l"}], "]"}], "]"}], ",", "n", ",", "m", ",", "d"}], "]"}], ",", RowBox[{"{", RowBox[{"l", ",", RowBox[{"Length", "@", "irreps"}]}], "}"}]}], "]"}], ",", "TrueQ"}], "]"}]], "Input"],

Cell["The generators on the tensor space", "Section"],

Cell["The mixed Schur transform S block-diagonalizes the action of the algebra on the tensor space: S P_i S^T is the direct sum, over the irreps, of the Gelfand-Tsetlin matrices of \[Sigma]_i tensored with the identity on the corresponding irrep of U(d). We check this on a smaller example, where P_i swaps the tensor factors i and i + 1, and P_n is the partial transpose of that swap.", "Text"],

Cell[BoxData[{RowBox[{"tensorGenerator", "[", RowBox[{"i_", ",", "n_", ",", "m_", ",", "d_"}], "]", ":=", "With", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"strings", "=", "StandardBasis", "[", RowBox[{RowBox[{"n", "+", "m"}], ",", "d"}], "]"}], ",", RowBox[{"index", "=", "FromDigits", "[", RowBox[{RowBox[{"#", "-", "1"}], ",", "d"}], "]", "+", "1", "&"}]}], "}"}], ",", RowBox[{"\[IndentingNewLine]", "SparseArray", "[", RowBox[{RowBox[{"Flatten", "@", "Table", "[", RowBox[{RowBox[{"\[IndentingNewLine]", "If", "[", RowBox[{RowBox[{"i", "!=", "n"}], ",", RowBox[{"\[IndentingNewLine]", "{", RowBox[{RowBox[{"index", "@", "ReplacePart", "[", RowBox[{"x", ",", RowBox[{"{", RowBox[{RowBox[{"i", "->", "x", "[", RowBox[{"[", RowBox[{"i", "+", "1"}], "]"}], "]"}], ",", RowBox[{"i", "+", "1", "->", "x", "[", RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}], ",", RowBox[{"index", "@", "x"}]}], "}", "->", "1"}], ",", RowBox[{"\[IndentingNewLine]", "If", "[", RowBox[{RowBox[{"x", "[", RowBox[{"[", "n", "]"}], "]", "==", "x", "[", RowBox[{"[", RowBox[{"n", "+", "1"}], "]"}], "]"}], ",", RowBox[{"Table", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"index", "@", "ReplacePart", "[", RowBox[{"x", ",", RowBox[{"{", RowBox[{RowBox[{"n", "->", "a"}], ",", RowBox[{"n", "+", "1", "->", "a"}]}], "}"}]}], "]"}], ",", RowBox[{"index", "@", "x"}]}], "}", "->", "1"}], ",", RowBox[{"{", RowBox[{"a", ",", "d"}], "}"}]}], "]"}], ",", RowBox[{"{", "}"}]}], "]", "\[IndentingNewLine]"}]}], "]"}], ",", RowBox[{"\[IndentingNewLine]", "{", RowBox[{"x", ",", "strings"}], "}"}]}], "]"}], ",", RowBox[{"{", RowBox[{RowBox[{"d", "^", "(", RowBox[{"n", "+", "m"}], ")"}], ",", RowBox[{"d", "^", "(", RowBox[{"n", "+", "m"}], ")"}]}], "}"}]}], "]", "\[IndentingNewLine]"}]}], "]"}], "\[IndentingNewLine]", RowBox[{"blockDiagonal", "[", "blocks_", "]", ":=", "SparseArray", "@", "ArrayFlatten", "@", "Table", "[", RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"i", "==", "j"}], ",", RowBox[{"blocks", "[", RowBox[{"[", "i", "]"}], "]"}], ",", "0"}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", RowBox[{"Length", "@", "blocks"}]}], "}"}], ",", RowBox[{"{", RowBox[{"j", ",", RowBox[{"Length", "@", "blocks"}]}], "}"}]}], "]"}], "\[IndentingNewLine]", RowBox[{"zeroQ", "[", "a_", "]", ":=", "AllTrue", "[", RowBox[{RowBox[{"Flatten", "@", "Normal", "@", "a"}], ",", "PossibleZeroQ"}], "]"}]}], "Input"],

Cell[BoxData[RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"n", "=", "2"}], ",", RowBox[{"m", "=", "2"}], ",", RowBox[{"d", "=", "2"}]}], "}"}], ",", RowBox[{"\[IndentingNewLine]", "With", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"S", "=", "SchurTransform", "[", RowBox[{"n", ",", "m", ",", "d"}], "]"}], ",", RowBox[{"gens", "=", "GeneratorsGT", "[", RowBox[{"n", ",", "m", ",", "d"}], "]"}]}], "}"}], ",", RowBox[{"\[IndentingNewLine]", "Table", "[", RowBox[{RowBox[{"\[IndentingNewLine]", "zeroQ", "[", RowBox[{"S", ".", "tensorGenerator", "[", RowBox[{"i", ",", "n", ",", "m", ",", "d"}], "]", ".", "Transpose", "[", "S", "]", "-", "\[IndentingNewLine]", "blockDiagonal", "@", "MapThread", "[", RowBox[{"KroneckerProduct", ",", RowBox[{"{", RowBox[{RowBox[{"gens", "[", RowBox[{"[", "i", "]"}], "]"}], ",", RowBox[{"IdentityMatrix", "/@", "IrrepDimsGL", "[", RowBox[{"n", ",", "m", ",", "d"}], "]"}]}], "}"}]}], "]"}], "]"}], ",", RowBox[{"\[IndentingNewLine]", "{", RowBox[{"i", ",", RowBox[{"n", "+", "m", "-", "1"}]}], "}", "\[IndentingNewLine]"}]}], "]", "\[IndentingNewLine]"}]}], "]", "\[IndentingNewLine]"}]}], "]"}]], "Input"]
},
StyleDefinitions->"Default.nb"
]
